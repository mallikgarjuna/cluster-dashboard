// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // relationMode = 'prisma'  //needed only for Planetscale
}

model Grant {
  // id               Int         @default(autoincrement()) @ignore
  // newId            String      @default(cuid()) @ignore
  id               String            @id @default(cuid())
  title            String            @default("") @db.VarChar(255)
  description      String            @default("") @db.Text
  status           StatusGrant       @default(DRAFT)
  acronym          String?           @default("") @db.VarChar(255)
  budgetTotal      Int?              @default(0)
  fundingAgency    String?           @default("") @db.VarChar(255)
  fundingProgramme String?           @default("") @db.VarChar(255)
  fundingCall      String?           @default("") @db.VarChar(255)
  submissionDate   DateTime?
  deadline         DateTime?
  decisionDate     DateTime?
  projectStartDate DateTime?
  projectEndDate   DateTime?
  notes            String?           @default("") @db.Text
  projectNumber    Int? // This field is optional and defaults to null if not provided
  applicantRole    enumApplicantRole @default(MAIN_APPLICANT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assignedToUserId String?           @db.VarChar(255)
  assignedToUser   User?             @relation("GrantAssignedToUser", fields: [assignedToUserId], references: [id])
  createdByUserId  String?           @db.VarChar(255)
  createdByUser    User?             @relation("GrantCreatedByUser", fields: [createdByUserId], references: [id])
}

enum StatusGrant {
  DRAFT
  SUBMITTED
  AWARDED
  REJECTED
  RUNNING_PROJECT
  DELETED
  ENDED_PROJECT
}

enum enumApplicantRole {
  MAIN_APPLICANT
  CO_APPLICANT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String      @id @default(cuid())
  name              String?
  firstName         String?
  lastName          String?
  email             String?     @unique
  emailVerified     DateTime?
  hashedPassword    String?
  image             String?
  role              UserRole    @default(USER)
  accounts          Account[]
  sessions          Session[]
  assignedGrants    Grant[]     @relation("GrantAssignedToUser")
  relatedDepartment Department? @relation(fields: [departmentId], references: [id])
  departmentId      String?
  createdGrants     Grant[]     @relation("GrantCreatedByUser")
}

enum UserRole {
  USER
  ADMIN
  GRANTOFFICER
  MANAGER
  HEAD
  GROUPLEADER
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  // id        Int?                  @default(autoincrement()) @ignore
  // newId     String                @default(cuid()) @ignore
  id        String                @id @default(cuid())
  nameFull  String
  nameShort OSDepartmentShortName
  members   User[]
}

enum OSDepartmentShortName {
  BBT
  BMS
  ERIBA
}

model FundingAgency {
  id                String             @id @default(cuid())
  name              String
  localityType      enumLocalityType
  sectorType        enumSectorType
  url               String?
  fundingProgrammes FundingProgramme[]
}

enum enumLocalityType {
  REGIONAL
  NATIONAL
  EU
  NON_EU
}

enum enumSectorType {
  PUBLIC_SECTOR
  PRIVATE_SECTOR
  THIRD_SECTOR
}

model FundingProgramme {
  id                    String         @id @default(cuid())
  name                  String
  realatedFundingAgency FundingAgency? @relation(fields: [fundingAgencyId], references: [id])
  fundingAgencyId       String?
  fundingCalls          FundingCall[]
}

model FundingCall {
  id                      String            @id @default(cuid())
  name                    String
  url                     String?
  relatedFundingProgramme FundingProgramme? @relation(fields: [fundingProgrammeId], references: [id])
  fundingProgrammeId      String?
}
