// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // relationMode = 'prisma'  //needed only for Planetscale
}

model Grant {
  id               Int         @id @default(autoincrement())
  title            String      @default("") @db.VarChar(255)
  description      String      @default("") @db.Text
  status           StatusGrant @default(DRAFT)
  acronym          String?     @default("") @db.VarChar(255)
  budgetTotal      Int?        @default(0)
  submissionDate   DateTime?
  deadline         DateTime?
  decisionDate     DateTime?
  notes            String?     @default("") @db.Text
  projectNumber    Int?        @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  assignedToUserId String?     @db.VarChar(255)
  assignedToUser   User?       @relation(fields: [assignedToUserId], references: [id])
}

enum StatusGrant {
  DRAFT
  SUBMITTED
  AWARDED
  REJECTED
  RUNNING_PROJECT
  DELETED
  ENDED_PROJECT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String      @id @default(cuid())
  name              String?
  firstName         String?
  lastName          String?
  email             String?     @unique
  emailVerified     DateTime?
  hashedPassword    String?
  image             String?
  role              UserRole    @default(USER)
  accounts          Account[]
  sessions          Session[]
  assignedGrants    Grant[]
  relatedDepartment Department? @relation(fields: [departmentId], references: [id])
  departmentId      Int?
}

enum UserRole {
  USER
  ADMIN
  GRANTOFFICER
  MANAGER
  HEAD
  GROUPLEADER
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id        Int                   @id @default(autoincrement())
  nameFull  String
  nameShort OSDepartmentShortName
  members   User[]
}

enum OSDepartmentShortName {
  BBT
  BMS
  ERIBA
}
